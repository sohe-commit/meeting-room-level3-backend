# 이 파일을 복사해서 .env 를 만들고 값을 채우세요. (.env 는 GitHub에 올라가지 않습니다)
PORT=4100
# Render PostgreSQL 주소 (External Database URL)
DATABASE_URL=
# 이 과제 전용 스키마 이름
DB_SCHEMA=meeting_room
# 로그인 증표를 만드는 비밀 문자열 (아무 긴 무작위 문자열)
JWT_SECRET=
# OpenAI GPT API 키 (백엔드에만 넣습니다)
GPT_API_KEY=
GPT_MODEL=gpt-4o-mini
# 프론트엔드 주소 (여러 개면 쉼표로 구분)
FRONTEND_URL=http://localhost:3100
